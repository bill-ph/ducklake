# name: test/sql/stats/global_stats_time_travel.test
# description: test global table stats are not reused across snapshots
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/global_stats_time_travel')

statement ok
CREATE TABLE ducklake.test(i INTEGER);

statement ok
INSERT INTO ducklake.test VALUES (10);

query I
SELECT stats(i)::VARCHAR LIKE '%10%' FROM ducklake.test LIMIT 1
----
true

statement ok
SET VARIABLE old_snapshot = (SELECT max(snapshot_id) FROM ducklake.snapshots());

statement ok
INSERT INTO ducklake.test VALUES (1000);

query I
SELECT stats(i)::VARCHAR LIKE '%1000%' FROM ducklake.test LIMIT 1
----
true

query I
SELECT stats(i)::VARCHAR LIKE '%1000%' FROM ducklake.test AT (VERSION => getvariable('old_snapshot')) LIMIT 1
----
false

query I
SELECT count(*) FROM ducklake.test AT (VERSION => getvariable('old_snapshot'))
----
1
